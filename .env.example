# Database (use a standard postgresql:// URL for Neon/local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional: used when DATABASE_URL is a prisma+postgres local dev URL
PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# App
BASE_URL="http://localhost:3000"

# SMTP (optional — invite/reset links are returned in API responses if email fails)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="user@example.com"
EMAIL_PASS="your-smtp-password"
EMAIL_FROM="PaperFlow ERP <noreply@example.com>"

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
