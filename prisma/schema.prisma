generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (M1) ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  WORKER
  SALES
  FINANCE
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  Role                   @default(WORKER)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  resetTokens           PasswordResetToken[]
  auditLogs             AuditLog[]
  inventoryTransactions InventoryTransaction[]
  productionStages      ProductionStage[]      @relation("StageWorker")
  assignedOrders        ProductionOrder[]      @relation("OrderAssignee")
  qcRecords             QCRecord[]
  machineDowntimes      MachineDowntime[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  model     String
  recordId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([model])
  @@index([createdAt])
}

// ─── Inventory (M2) — materials only, no rolls ─────────────────────────────

enum MaterialUnit {
  KG
  METER
  BAG
  CARTON
  PCS
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  RETURN
  WASTE
  ADJUSTMENT
}

enum MaterialType {
  PAPER_ROLL
  GLUE
  INK
  ROPE
  KAPTON
  SPONGE
  CARTON
}

model Material {
  id                String                 @id @default(cuid())
  materialType      MaterialType
  name              String
  code              String                 @unique
  supplierId        String?
  supplier          Supplier?              @relation(fields: [supplierId], references: [id])
  unit              String
  minimumStock      Decimal                @default(0) @db.Decimal(14, 4)
  kgPerMeter        Decimal?               @db.Decimal(14, 6)
  paperType         String?
  paperColor        String?
  paperLengthM      Decimal?               @db.Decimal(14, 4)
  paperWidthCm      Decimal?               @db.Decimal(10, 2)
  gsm               Int?
  receivingDate     DateTime?
  barCode           String?
  glueType          String?
  inkColor          String?
  weightKg          Decimal?               @db.Decimal(14, 4)
  ropeColor         String?
  ropeLengthM       Decimal?               @db.Decimal(14, 4)
  ropeWeightKg      Decimal?               @db.Decimal(14, 4)
  ropeRolls         Int?
  gluePacks         Int?
  inkDrums          Int?
  cartonQty         Int?
  tapeType          String?
  size              String?
  sheetCount        Int?
  cartonSize        String?
  cartonLength      Decimal?               @db.Decimal(10, 2)
  cartonWidth       Decimal?               @db.Decimal(10, 2)
  cartonHeight      Decimal?               @db.Decimal(10, 2)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  transactions      InventoryTransaction[]
  stageConsumptions StageConsumption[]
  stages            ProductionStage[]

  @@index([materialType])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  materialId      String
  material        Material                 @relation(fields: [materialId], references: [id])
  transactionType InventoryTransactionType
  quantity        Decimal                  @db.Decimal(14, 4)
  unit            MaterialUnit
  referenceId     String?
  remarks         String?
  createdById     String?
  createdBy       User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime                 @default(now())

  @@index([materialId])
  @@index([createdAt])
}

// ─── Machines ──────────────────────────────────────────────────────────────

enum MachineStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DOWN
}

model Machine {
  id          String             @id @default(cuid())
  name        String
  machineCode String             @unique
  stageType   StageType
  status      MachineStatus      @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  downtimes   MachineDowntime[]
  stages      ProductionStage[]
  qcRecords   QCRecord[]
}

model MachineDowntime {
  id          String    @id @default(cuid())
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  reason      String
  startTime   DateTime
  endTime     DateTime?
  durationMin Int?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([machineId])
}

// ─── Customers & Production ────────────────────────────────────────────────

enum CustomerKind {
  PERSON
  COMPANY
}

model Customer {
  id          String           @id @default(cuid())
  name        String
  companyName String?
  kind        CustomerKind     @default(COMPANY)
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  orders      ProductionOrder[]

  @@index([name])
}

enum StageType {
  RAW_MATERIAL
  SLITTING
  PRINTING
  PRINT_QC
  HANDLE_MAKING_PASTING
  QUALITY_CHECK
  PACKING
  DISPATCH
}

enum StageStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
}

enum ProductionOrderStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELLED
}

enum RemainderAction {
  WASTE
  RESTOCK
}

model ProductionOrder {
  id                String                @id @default(cuid())
  orderNo           String                @unique
  customerId        String
  customer          Customer              @relation(fields: [customerId], references: [id])
  salesRep          String?
  assignedWorkerId  String?
  assignedWorker    User?                 @relation("OrderAssignee", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  startDate         DateTime?
  deliveryDate      DateTime?
  status            ProductionOrderStatus @default(PENDING)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lines             OrderLine[]
  yieldRecords      YieldRecord[]

  @@index([status])
  @@index([customerId])
  @@index([assignedWorkerId])
}

model OrderLine {
  id          String           @id @default(cuid())
  orderId     String
  order       ProductionOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  heightMm    Decimal?         @db.Decimal(10, 2)
  widthMm     Decimal?         @db.Decimal(10, 2)
  baseMm      Decimal?         @db.Decimal(10, 2)
  fileUrl     String?
  fileName    String?
  plannedQty  Decimal          @db.Decimal(14, 4)
  lineNo      Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  stages      ProductionStage[]

  @@unique([orderId, lineNo])
  @@index([orderId])
}

model ProductionStage {
  id              String           @id @default(cuid())
  orderId         String
  orderLineId     String
  orderLine       OrderLine        @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  stageType       StageType
  sequence        Int
  inputQty        Decimal?         @db.Decimal(14, 4)
  outputQty       Decimal?         @db.Decimal(14, 4)
  wasteQty        Decimal?         @db.Decimal(14, 4)
  inputUnit       MaterialUnit?
  outputUnit      MaterialUnit?
  status          StageStatus      @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  workerId        String?
  worker          User?            @relation("StageWorker", fields: [workerId], references: [id], onDelete: SetNull)
  machineId       String?
  machine         Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)
  materialId      String?
  material        Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  cutWidthMm      Decimal?         @db.Decimal(10, 2)
  pieceCount      Int?
  pieceWeightKg   Decimal?         @db.Decimal(14, 4)
  remainderAction RemainderAction?
  remainderQty    Decimal?         @db.Decimal(14, 4)
  lengthRestockQty Decimal?        @db.Decimal(14, 4)
  proofUrls       Json?
  remarks         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  qcRecords       QCRecord[]
  yieldRecord     YieldRecord?
  consumptions    StageConsumption[]

  @@unique([orderLineId, sequence])
  @@index([orderId])
  @@index([orderLineId])
  @@index([workerId])
  @@index([status])
}

enum ConsumptionKind {
  GLUE_SIDE
  GLUE_BOTTOM
  HANDLE_ROPE
}

model DefectCategory {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  defectTypes DefectType[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DefectType {
  id          String          @id @default(cuid())
  stageType   StageType
  code        String
  description String
  categoryId  String?
  category    DefectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  qcRecords   QCRecord[]

  @@unique([stageType, code])
}

model QCRecord {
  id           String          @id @default(cuid())
  stageId      String
  stage        ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  passedQty    Decimal         @db.Decimal(14, 4)
  rejectedQty  Decimal         @default(0) @db.Decimal(14, 4)
  defectTypeId String?
  defectType   DefectType?     @relation(fields: [defectTypeId], references: [id], onDelete: SetNull)
  photoUrl     String?
  machineId    String?
  machine      Machine?        @relation(fields: [machineId], references: [id], onDelete: SetNull)
  remarks      String?
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([stageId])
}

model StageConsumption {
  id              String          @id @default(cuid())
  stageId         String
  stage           ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material        @relation(fields: [materialId], references: [id])
  consumptionKind ConsumptionKind
  plannedQty      Decimal         @db.Decimal(14, 4)
  actualQty       Decimal         @db.Decimal(14, 4)
  unit            MaterialUnit
  variance        Decimal         @db.Decimal(14, 4)
  createdAt       DateTime        @default(now())

  @@unique([stageId, consumptionKind])
  @@index([stageId])
}

model YieldRecord {
  id           String          @id @default(cuid())
  orderId      String
  order        ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stageId      String          @unique
  stage        ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  expectedQty  Decimal         @db.Decimal(14, 4)
  actualQty    Decimal         @db.Decimal(14, 4)
  yieldPercent Decimal         @db.Decimal(8, 4)
  variance     Decimal         @db.Decimal(14, 4)
  createdAt    DateTime        @default(now())

  @@index([orderId])
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  companyName   String?
  contactPerson String?
  email         String?
  contactNumber String?
  address       String?
  notes         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  materials     Material[]
}

